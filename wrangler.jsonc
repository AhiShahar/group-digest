// Cloudflare Workers: the web app (static assets) plus small APIs under /api/
// (worker/index.ts): the live-sync relay (one SQLite Durable Object per linked
// phone) and web push reminders (one per browser). Free plan.
// Build: npm run build    Deploy: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "group-digest",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SYNC", "class_name": "SyncRoom" },
      { "name": "PUSH", "class_name": "PushBox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PushBox"] }
  ]
}
